# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local media sources and optimized upload artifacts
/.media-source/
/.media-output/
/public/projects/*/gallery/**/*.avif
/public/projects/*/gallery/**/*.gif
/public/projects/*/gallery/**/*.jpg
/public/projects/*/gallery/**/*.jpeg
/public/projects/*/gallery/**/*.png
/public/projects/*/gallery/**/*.webp
/public/projects/*/gallery/**/*.mp4
/public/projects/*/gallery/**/*.mov
/public/projects/*/gallery/**/*.webm

# misc
.DS_Store
*.pem
.claude/
.playwright-mcp/
hero-*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
